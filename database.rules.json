{
  "rules": {
    "bookings":     { ".read": true, ".write": true, ".indexOn": ["createdAt", "date"] },
    "packages":     { ".read": true, ".write": true, ".indexOn": ["sortOrder"] },
    "memberships":  { ".read": true, ".write": true, ".indexOn": ["createdAt"] },
    "services":     { ".read": true, ".write": true },
    "blockedDates": { ".read": true, ".write": true },
