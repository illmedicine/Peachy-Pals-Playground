rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      // Only the verified admin account uploads images (packages, events, blog, services)
      allow write: if request.auth != null
        && request.auth.token.email == 'info@kdconcierge.com'
        && request.auth.token.email_verified == true;
    }
  }
}
